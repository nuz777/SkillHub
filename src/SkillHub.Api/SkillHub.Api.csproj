<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SkillHub.Api</RootNamespace>
        <NoWarn>$(NoWarn);NU1902;NU1903;CS0618</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SkillHub.Application\SkillHub.Application.csproj" />
        <ProjectReference Include="..\SkillHub.Domain\SkillHub.Domain.csproj" />
        <ProjectReference Include="..\SkillHub.Infrastructure\SkillHub.Infrastructure.csproj" />
    </ItemGroup>

</Project>
