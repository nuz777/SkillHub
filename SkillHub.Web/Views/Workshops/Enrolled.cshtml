@model IEnumerable<SkillHub.Application.DTOs.EnrollmentDto>
@{
    var workshop = ViewBag.Workshop as SkillHub.Application.DTOs.WorkshopDto;
    ViewData["Title"] = $"Inscritos - {workshop?.Title}";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <a asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-2">
            <i class="bi bi-arrow-left me-1"></i> Volver a talleres
        </a>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-people text-primary me-2"></i>Participantes Inscritos
        </h2>
        <p class="text-muted">
            Taller: <strong>@workshop?.Title</strong> (<span class="badge bg-secondary">@workshop?.Code</span>) —
            Cupos: <strong>@workshop?.ActiveEnrollmentsCount / @workshop?.MaxCapacity</strong> ocupados
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <i class="bi bi-person-x text-muted display-4"></i>
            <h5 class="mt-3 text-muted">Aún no hay participantes inscritos en este taller.</h5>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Participante</th>
                        <th>Correo Electrónico</th>
                        <th>Fecha de Inscripción</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-primary me-2"></i>@item.ParticipantName
                            </td>
                            <td>@item.ParticipantEmail</td>
                            <td class="text-secondary small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</td>
                            <td>
                                @if (item.Status == SkillHub.Domain.Enums.EnrollmentStatus.Active)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
