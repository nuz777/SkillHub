@model IEnumerable<SkillHub.Application.DTOs.EnrollmentDto>
@{
    ViewData["Title"] = "Mis Inscripciones";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-bookmark-check-fill text-primary me-2"></i>Mis Inscripciones
        </h2>
        <p class="text-muted mb-0">Gestiona tus cupos confirmados, descarga constancias oficiales en PDF y revisa el estado de tus talleres.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Workshops" asp-action="Index" class="btn btn-outline-primary fw-semibold" style="border-radius: 10px;">
            <i class="bi bi-plus-circle me-1"></i> Explorar Más Talleres
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card sh-card text-center py-5">
        <div class="card-body">
            <div class="bg-light text-muted p-4 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-journal-x fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark">Aún no tienes inscripciones registradas</h5>
            <p class="text-muted small">Explora el catálogo de talleres disponibles y asegura tu cupo presencial.</p>
            <a asp-controller="Workshops" asp-action="Index" class="btn btn-sh-primary btn-sm px-4 fw-semibold mt-2">
                Ver Catálogo de Talleres
            </a>
        </div>
    </div>
}
else
{
    <div class="card sh-card overflow-hidden shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr class="text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                        <th class="ps-4 py-3">Taller Presencial</th>
                        <th>Instructor</th>
                        <th>Inscripción</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isActive = item.Status == SkillHub.Domain.Enums.EnrollmentStatus.Active;

                        <tr>
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@item.WorkshopTitle</div>
                                <span class="badge bg-light text-secondary border font-monospace small">@item.WorkshopCode</span>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@item.InstructorName</div>
                            </td>
                            <td>
                                <div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle badge-enterprise d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle badge-enterprise d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-x-circle"></i> Cancelada
                                    </span>
                                    @if (item.CancelledAt.HasValue)
                                    {
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            @item.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    @if (isActive)
                                    {
                                        <a asp-action="Certificate" asp-route-id="@item.Id" class="btn btn-sm btn-success fw-semibold shadow-xs" style="border-radius: 8px;" title="Descargar Constancia Oficial en PDF">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Constancia PDF
                                        </a>

                                        @if (item.CanCancel)
                                        {
                                            <form asp-action="Cancel" method="post" onsubmit="return confirm('¿Seguro que deseas cancelar tu inscripción? Se liberará el cupo.');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold" style="border-radius: 8px;">
                                                    <i class="bi bi-x-circle me-1"></i> Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;" disabled title="Solo se puede cancelar hasta 24 horas antes del inicio del taller">
                                                <i class="bi bi-lock-fill me-1"></i> No cancelable (&lt;24h)
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Cupo liberado</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
