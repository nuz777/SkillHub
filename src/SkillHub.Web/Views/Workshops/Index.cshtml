@model IEnumerable<SkillHub.Application.DTOs.WorkshopDto>
@{
    ViewData["Title"] = "Talleres Presenciales";
    var isEmployee = User.IsInRole(UserRoles.Employee);
    var totalSpots = Model.Sum(w => w.AvailableSpots);
}

@section Hero {
    <!-- Full-Width Enterprise Hero Banner -->
    <div class="sh-hero-banner position-relative text-white overflow-hidden py-5">
        <div class="sh-hero-glow-1"></div>
        <div class="sh-hero-glow-2"></div>
        <div class="sh-hero-grid-pattern"></div>

        <div class="container position-relative py-lg-4" style="z-index: 2;">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-7">
                    <!-- Chip tag -->
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 shadow-sm" style="background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2);">
                        <span class="badge bg-success rounded-pill px-2 py-1 small" style="font-size: 0.72rem;">
                            <i class="bi bi-broadcast me-1"></i> Talleres Presenciales 2026
                        </span>
                        <span class="text-white small fw-medium">Centro de Formación SkillHub</span>
                    </div>

                    <!-- Main Heading -->
                    <h1 class="display-5 fw-bold text-white tracking-tight mb-3" style="letter-spacing: -1.2px; line-height: 1.15;">
                        Aprende con los Mejores Instructores en <span style="background: linear-gradient(135deg, #60a5fa, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Talleres Prácticos</span>
                    </h1>

                    <p class="lead text-light opacity-90 mb-4" style="font-size: 1.08rem; max-width: 600px; line-height: 1.6;">
                        Potencia tus habilidades presenciales en grupos reducidos con retroalimentación inmediata, cupos verificados en tiempo real y constancia oficial de inscripción en PDF.
                    </p>

                    <!-- CTAs -->
                    <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                        <a href="#catalog" class="btn btn-light text-primary px-4 py-2 fw-bold shadow-sm" style="border-radius: 10px;">
                            <i class="bi bi-grid-fill me-1"></i> Explorar Catálogo
                        </a>

                        @if (isEmployee)
                        {
                            <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm text-white" style="border-radius: 10px; background: rgba(59, 130, 246, 0.35); border: 1px solid rgba(255, 255, 255, 0.3); backdrop-filter: blur(8px);">
                                <i class="bi bi-plus-circle-fill me-1"></i> Publicar Taller
                            </a>
                            <a asp-controller="Enrollments" asp-action="Import" class="btn btn-outline-light px-3 py-2 fw-semibold" style="border-radius: 10px;">
                                <i class="bi bi-file-earmark-excel me-1 text-success"></i> Importar Excel
                            </a>
                        }
                        else if (!User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light px-4 py-2 fw-semibold" style="border-radius: 10px;">
                                <i class="bi bi-person-plus me-1"></i> Crear Cuenta
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Enrollments" asp-action="Index" class="btn btn-outline-light px-4 py-2 fw-semibold" style="border-radius: 10px;">
                                <i class="bi bi-bookmark-check-fill me-1"></i> Mis Inscripciones
                            </a>
                        }
                    </div>

                    <!-- Highlights -->
                    <div class="d-flex flex-wrap align-items-center gap-4 mt-4 pt-3 border-top border-white border-opacity-10 small text-light opacity-75">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-info fs-5"></i>
                            <span>Certificación oficial en PDF</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                            <span>Inscripción instantánea</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                            <span>100% Presencial</span>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Quick Stats & Floating Card Preview -->
                <div class="col-lg-5">
                    <div class="p-4 rounded-4 shadow-lg position-relative" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.18);">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom border-white border-opacity-10">
                            <div>
                                <span class="badge bg-primary bg-opacity-50 text-white border border-primary-subtle small text-uppercase fw-bold px-2 py-1">Disponibilidad en Vivo</span>
                                <h5 class="text-white fw-bold mt-2 mb-0">Cupos y Talleres Activos</h5>
                            </div>
                            <div class="bg-success text-white p-2 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                                <i class="bi bi-check2-circle fs-4"></i>
                            </div>
                        </div>

                        <div class="row g-3 text-center mb-3">
                            <div class="col-6">
                                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08);">
                                    <div class="display-6 fw-bold text-white">@Model.Count()</div>
                                    <div class="text-light opacity-75 small fw-semibold">Talleres Disponibles</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08);">
                                    <div class="display-6 fw-bold text-warning">@totalSpots</div>
                                    <div class="text-light opacity-75 small fw-semibold">Cupos Libres</div>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3);">
                            <i class="bi bi-info-circle-fill text-success fs-4"></i>
                            <div class="small text-white">
                                <strong>Cancelación flexible:</strong> Puedes cancelar tu inscripción con hasta 24 horas de anticipación sin penalización.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Catalog Section -->
<div id="catalog" class="row align-items-center mb-4 pb-2 pt-2">
    <div class="col-md-7">
        <h2 class="h3 fw-bold text-dark tracking-tight mb-1">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Catálogo de Formación
        </h2>
        <p class="text-muted mb-0">Explora los talleres presenciales programados y asegura tu cupo.</p>
    </div>
    @if (isEmployee)
    {
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-sh-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Publicar Taller
            </a>
            <a asp-controller="Enrollments" asp-action="Import" class="btn btn-outline-success fw-semibold ms-1" style="border-radius: 10px;">
                <i class="bi bi-file-earmark-excel me-1"></i> Importar Excel
            </a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card sh-card text-center py-5 shadow-sm">
        <div class="card-body">
            <div class="bg-light text-muted p-4 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-calendar-x fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark">No hay talleres futuros disponibles</h5>
            <p class="text-muted small">Todos los talleres han iniciado o aún no se han programado nuevos cupos.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var workshop in Model)
        {
            var occupancyPercent = workshop.MaxCapacity > 0 
                ? (int)Math.Min(100, Math.Round((double)workshop.ActiveEnrollmentsCount / workshop.MaxCapacity * 100))
                : 100;
            var isFull = workshop.AvailableSpots <= 0;

            // Iniciales del instructor para el avatar
            var instructorInitials = string.Join("", (workshop.InstructorName ?? "SH")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(s => s[0]))
                .ToUpper();

            <div class="col-md-6 col-lg-4">
                <div class="card sh-card sh-card-hover h-100 p-3 p-xl-4 d-flex flex-column shadow-sm">
                    <!-- Card Top Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-secondary border fw-bold" style="border-radius: 6px; font-size: 0.78rem;">
                            <i class="bi bi-upc me-1"></i>@workshop.Code
                        </span>
                        @if (!isFull)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i> @workshop.AvailableSpots cupos libres
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill"></i> Cupos agotados
                            </span>
                        }
                    </div>

                    <!-- Workshop Title & Description -->
                    <h5 class="fw-bold text-dark mb-2" style="line-height: 1.35;">@workshop.Title</h5>
                    <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                        @(workshop.Description.Length > 115 ? workshop.Description[..112] + "..." : workshop.Description)
                    </p>

                    <!-- Occupancy Progress Bar -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1" style="font-size: 0.75rem;">
                            <span>Ocupación (@workshop.ActiveEnrollmentsCount/@workshop.MaxCapacity)</span>
                            <span class="fw-bold">@occupancyPercent%</span>
                        </div>
                        <div class="progress" style="height: 6px; border-radius: 4px; background: #e2e8f0;">
                            <div class="progress-bar @(isFull ? "bg-danger" : occupancyPercent > 70 ? "bg-warning" : "bg-primary")" 
                                 role="progressbar" 
                                 style="width: @occupancyPercent%; border-radius: 4px;" 
                                 aria-valuenow="@occupancyPercent" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>

                    <!-- Instructor & Schedule Details -->
                    <div class="bg-light rounded-3 p-3 mb-3 small border border-light-subtle">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="sh-avatar" style="width: 30px; height: 30px; font-size: 0.75rem;">
                                @instructorInitials
                            </div>
                            <div class="text-truncate">
                                <span class="d-block fw-semibold text-dark lh-1">@workshop.InstructorName</span>
                                <span class="text-muted" style="font-size: 0.72rem;">@workshop.InstructorEmail</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 text-secondary pt-2 border-top" style="font-size: 0.78rem;">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span>@workshop.StartDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@workshop.Id" class="btn btn-outline-secondary btn-sm flex-fill fw-semibold" style="border-radius: 8px;">
                            Detalle
                        </a>

                        @if (isEmployee)
                        {
                            var currentEmail = User.Identity?.Name ?? string.Empty;
                            var isOwner = string.Equals(workshop.InstructorEmail, currentEmail, StringComparison.OrdinalIgnoreCase) || currentEmail.Contains("admin");

                            <a asp-action="Enrolled" asp-route-id="@workshop.Id" class="btn btn-outline-dark btn-sm flex-fill fw-semibold" style="border-radius: 8px;">
                                <i class="bi bi-people me-1"></i>Inscritos (@workshop.ActiveEnrollmentsCount)
                            </a>

                            @if (isOwner && !workshop.HasStarted)
                            {
                                <a asp-action="Edit" asp-route-id="@workshop.Id" class="btn btn-outline-primary btn-sm fw-semibold" style="border-radius: 8px;" title="Editar Taller">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            }
                        }
                        else
                        {
                            @if (!isFull)
                            {
                                <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workshopId" value="@workshop.Id" />
                                    <button type="submit" class="btn btn-sh-primary btn-sm w-100 fw-semibold" style="border-radius: 8px;">
                                        <i class="bi bi-pencil-square me-1"></i>Inscribirme
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-light text-muted border btn-sm flex-fill fw-semibold" style="border-radius: 8px;" disabled>
                                    Agotado
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
