@{
    ViewData["Title"] = "Importación Masiva desde Excel";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-controller="Workshops" asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-3">
            <i class="bi bi-arrow-left me-1"></i> Volver a talleres
        </a>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-success text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-file-earmark-excel fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0">Inscripción Masiva desde Excel</h3>
                        <p class="text-muted small mb-0">Carga un archivo Excel (.xlsx) con las columnas <code>ParticipantEmail</code> y <code>WorkshopCode</code>.</p>
                    </div>
                </div>

                <div class="alert alert-info small border-0 bg-info-subtle text-info-emphasis mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Cada fila se procesa individualmente validando cupo máximo, sin duplicados y cruces de horario. Las filas válidas se guardan aunque otras fallen.
                </div>

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Seleccionar Archivo Excel (.xlsx)</label>
                        <input type="file" name="file" class="form-control form-control-lg" accept=".xlsx" required />
                        <div class="form-text small">Puedes utilizar la hoja <strong>Enrollments</strong> de tu archivo de datos.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-semibold">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Procesar Inscripciones
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
