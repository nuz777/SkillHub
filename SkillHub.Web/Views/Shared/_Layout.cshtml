<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card-workshop {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 12px;
        }
        .card-workshop:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }
        footer {
            margin-top: auto;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Workshops" asp-action="Index">
                <i class="bi bi-mortarboard-fill fs-4"></i> SkillHub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Workshops" asp-action="Index">
                            <i class="bi bi-calendar-event me-1"></i> Catálogo de Talleres
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Employee))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Workshops" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill me-1"></i> Publicar Taller
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Enrollments" asp-action="Import">
                                    <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Importar Excel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" href="http://localhost:5180/scalar" target="_blank">
                                    <i class="bi bi-terminal me-1"></i> Panel API / Scalar
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Enrollments" asp-action="Index">
                                    <i class="bi bi-card-checklist me-1"></i> Mis Inscripciones
                                </a>
                            </li>
                        }
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Employee))
                        {
                            <span class="badge bg-warning text-dark py-2 px-3 fw-semibold">
                                <i class="bi bi-person-badge-fill me-1"></i> Instructor: @User.Identity.Name
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark py-2 px-3 fw-semibold">
                                <i class="bi bi-person-fill me-1"></i> Participante: @User.Identity.Name
                            </span>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm fw-semibold" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </a>
                        <a class="btn btn-outline-light btn-sm fw-semibold" asp-controller="Account" asp-action="Register">
                            Registrarse
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small">
        <div class="container">
            &copy; @DateTime.UtcNow.Year SkillHub - Centro de Formación Presencial | API & Web Clean Architecture
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
