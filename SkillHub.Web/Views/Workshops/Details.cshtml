@model SkillHub.Application.DTOs.WorkshopDto
@{
    ViewData["Title"] = Model.Title;
    var userEmail = User.Identity?.Name ?? string.Empty;
    var isInstructorOwner = string.Equals(Model.InstructorEmail, userEmail, StringComparison.OrdinalIgnoreCase) || userEmail.Contains("admin");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-3 text-secondary fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver al catálogo de talleres
        </a>

        <div class="card sh-card fade-in-up border-0 shadow-sm overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-light text-secondary border fw-bold px-3 py-2">
                        <i class="bi bi-upc-scan me-1"></i> @Model.Code
                    </span>
                    @if (Model.AvailableSpots > 0)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i> @Model.AvailableSpots cupos disponibles
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-3 py-2">
                            <i class="bi bi-x-circle me-1"></i> Cupos agotados
                        </span>
                    }
                </div>

                <h1 class="h2 fw-bold text-dark mb-3">@Model.Title</h1>

                <div class="p-3 rounded-3 mb-4" style="background-color: #f8fafc; border-left: 4px solid var(--sh-primary);">
                    <p class="mb-0 text-secondary fs-6 leading-relaxed">@Model.Description</p>
                </div>

                <div class="row g-3 py-3 border-top border-bottom my-3">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase">Instructor a cargo</div>
                        <div class="fw-bold text-dark mt-1">
                            <i class="bi bi-person-badge text-primary me-1"></i>@Model.InstructorName
                        </div>
                        <div class="small text-muted">@Model.InstructorEmail</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase">Capacidad del Taller</div>
                        <div class="fw-bold text-dark mt-1">
                            <i class="bi bi-people-fill text-primary me-1"></i>@Model.MaxCapacity participantes
                        </div>
                        <div class="small text-muted">@Model.ActiveEnrollmentsCount inscritos actualmente</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase">Fecha y Hora de Inicio</div>
                        <div class="fw-bold text-dark mt-1">
                            <i class="bi bi-calendar-event text-primary me-1"></i>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-semibold text-uppercase">Fecha y Hora de Fin</div>
                        <div class="fw-bold text-dark mt-1">
                            <i class="bi bi-calendar-check text-primary me-1"></i>@Model.EndDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-4 pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 fw-semibold">
                        Ver otros talleres
                    </a>

                    @if (User.IsInRole(UserRoles.Employee))
                    {
                        <a asp-action="Enrolled" asp-route-id="@Model.Id" class="btn btn-outline-primary px-3 fw-semibold">
                            <i class="bi bi-people me-1"></i> Asistentes (@Model.ActiveEnrollmentsCount)
                        </a>

                        @if (isInstructorOwner && !Model.HasStarted)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark px-3 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Editar
                            </a>

                            @if (Model.ActiveEnrollmentsCount == 0)
                            {
                                <button type="button" class="btn btn-outline-danger px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#deleteWorkshopModal">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary px-3" disabled title="No se puede eliminar porque tiene participantes inscritos activos">
                                    <i class="bi bi-lock-fill me-1"></i> Con Inscritos
                                </button>
                            }
                        }
                    }
                    else
                    {
                        @if (Model.AvailableSpots > 0)
                        {
                            <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="workshopId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sh-primary px-4 fw-semibold">
                                    <i class="bi bi-pencil-square me-1"></i> Inscribirme Ahora
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary px-4 fw-semibold" disabled>
                                Cupos agotados
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole(UserRoles.Employee) && isInstructorOwner)
{
    @section Modals {
        <div class="modal fade" id="deleteWorkshopModal" tabindex="-1" aria-labelledby="deleteWorkshopModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger" id="deleteWorkshopModalLabel">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Taller
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="mb-2">¿Estás seguro de que deseas eliminar permanentemente el taller <strong>@Model.Title</strong> (<code>@Model.Code</code>)?</p>
                        <p class="text-muted small mb-0">Esta acción no se puede deshacer. Solo es posible eliminar talleres que no hayan iniciado y no cuenten con participantes inscritos.</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancelar</button>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm px-3 fw-semibold">
                                Confirmar Eliminación
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
