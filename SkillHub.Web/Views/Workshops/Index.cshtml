@model IEnumerable<SkillHub.Application.DTOs.WorkshopDto>
@{
    ViewData["Title"] = "Talleres Disponibles";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-calendar-check text-primary me-2"></i>Catálogo de Talleres Presenciales
        </h2>
        <p class="text-muted">Consulta los talleres futuros programados en SkillHub y asegura tu cupo.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox text-muted display-4"></i>
            <h5 class="mt-3 text-muted">No hay talleres futuros disponibles en este momento.</h5>
            <p class="text-secondary small">Vuelve a consultar más adelante o contacta al personal de SkillHub.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var workshop in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 card-workshop">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary-subtle text-secondary fw-semibold">
                                <i class="bi bi-tag me-1"></i>@workshop.Code
                            </span>
                            @if (workshop.AvailableSpots > 0)
                            {
                                <span class="badge bg-success-subtle text-success fw-semibold">
                                    <i class="bi bi-person-check me-1"></i>@workshop.AvailableSpots cupos disponibles
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger fw-semibold">
                                    <i class="bi bi-person-x me-1"></i>Cupos agotados
                                </span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-2">@workshop.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(workshop.Description.Length > 120 ? workshop.Description[..117] + "..." : workshop.Description)
                        </p>

                        <div class="border-top pt-3 mt-2 small text-secondary">
                            <div class="mb-1">
                                <i class="bi bi-person-badge text-primary me-2"></i>
                                <strong>Instructor:</strong> @workshop.InstructorName
                            </div>
                            <div class="mb-1">
                                <i class="bi bi-calendar3 text-primary me-2"></i>
                                <strong>Inicio:</strong> @workshop.StartDate.ToString("dd/MM/yyyy HH:mm") UTC
                            </div>
                            <div>
                                <i class="bi bi-clock text-primary me-2"></i>
                                <strong>Fin:</strong> @workshop.EndDate.ToString("dd/MM/yyyy HH:mm") UTC
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@workshop.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="bi bi-info-circle me-1"></i>Detalle
                            </a>
                            @if (workshop.AvailableSpots > 0)
                            {
                                <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workshopId" value="@workshop.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-pencil-square me-1"></i>Inscribirme
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm flex-fill" disabled>
                                    Agotado
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
