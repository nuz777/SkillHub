@model SkillHub.Application.DTOs.WorkshopDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-3">
            <i class="bi bi-arrow-left me-1"></i> Volver al catálogo de talleres
        </a>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-secondary fs-6">Código: @Model.Code</span>
                    @if (Model.AvailableSpots > 0)
                    {
                        <span class="badge bg-success fs-6">@Model.AvailableSpots cupos disponibles</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Cupos agotados</span>
                    }
                </div>

                <h1 class="h2 fw-bold text-dark mb-3">@Model.Title</h1>

                <div class="alert alert-light border my-3">
                    <p class="mb-0 text-secondary fs-6">@Model.Description</p>
                </div>

                <div class="row g-3 py-3 border-top border-bottom my-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Instructor a cargo</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-person-fill text-primary me-1"></i>@Model.InstructorName
                        </div>
                        <div class="small text-muted">@Model.InstructorEmail</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Cupo Máximo</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-people-fill text-primary me-1"></i>@Model.MaxCapacity participantes
                        </div>
                        <div class="small text-muted">Actualmente @Model.ActiveEnrollmentsCount inscritos activos</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Fecha y Hora de Inicio</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-calendar-event text-primary me-1"></i>@Model.StartDate.ToString("dd/MM/yyyy HH:mm") UTC
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Fecha y Hora de Fin</div>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-calendar-check text-primary me-1"></i>@Model.EndDate.ToString("dd/MM/yyyy HH:mm") UTC
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Ver otros talleres
                    </a>
                    @if (Model.AvailableSpots > 0)
                    {
                        <form asp-controller="Enrollments" asp-action="Enroll" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="workshopId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Confirmar Inscripción
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-danger px-4" disabled>
                            Cupos agotados
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
