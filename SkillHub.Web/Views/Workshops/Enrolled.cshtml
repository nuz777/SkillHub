@model IEnumerable<SkillHub.Application.DTOs.EnrollmentDto>
@{
    var workshop = ViewBag.Workshop as SkillHub.Application.DTOs.WorkshopDto;
    ViewData["Title"] = $"Inscritos - {workshop?.Title}";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <a asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-2 text-secondary fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a talleres
        </a>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Participantes Inscritos
        </h2>
        <p class="text-muted mb-0">
            Taller: <strong>@workshop?.Title</strong> (<span class="badge bg-light text-secondary border">@workshop?.Code</span>) —
            Cupos: <strong>@workshop?.ActiveEnrollmentsCount / @workshop?.MaxCapacity</strong> ocupados
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card sh-card fade-in-up border-0 text-center py-5 shadow-sm">
        <div class="card-body">
            <div class="p-3 rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-person-x text-muted fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark">Aún no hay participantes inscritos</h5>
            <p class="text-muted small mb-0">Cuando los estudiantes se inscriban o se realice una importación, aparecerán en este listado.</p>
        </div>
    </div>
}
else
{
    <div class="card sh-card fade-in-up border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Participante</th>
                        <th>Correo Electrónico</th>
                        <th>Fecha de Inscripción</th>
                        <th class="text-center pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sh-avatar" style="width: 32px; height: 32px; font-size: 0.78rem;">
                                        @(string.IsNullOrWhiteSpace(item.ParticipantName) ? "P" : item.ParticipantName.Substring(0, 1).ToUpper())
                                    </div>
                                    <span>@item.ParticipantName</span>
                                </div>
                            </td>
                            <td class="text-secondary">@item.ParticipantEmail</td>
                            <td class="text-secondary small">
                                <i class="bi bi-calendar3 me-1 text-muted"></i>
                                @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center pe-4">
                                @if (item.Status == SkillHub.Domain.Enums.EnrollmentStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-2 py-1">
                                        <i class="bi bi-x-circle-fill me-1"></i> Cancelada
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
