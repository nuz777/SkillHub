<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --sh-primary: #1e40af;
            --sh-primary-hover: #1d4ed8;
            --sh-primary-light: #eff6ff;
            --sh-dark: #0f172a;
            --sh-slate: #334155;
            --sh-border: #e2e8f0;
            --sh-card-bg: #ffffff;
            --sh-bg: #f8fafc;
            --sh-accent: #059669;
            --sh-accent-hover: #047857;
        }

        * {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--sh-bg);
            color: var(--sh-slate);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Glassmorphism Sticky Header */
        .sh-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            transition: all 0.25s ease;
        }

        .sh-navbar .navbar-brand {
            font-weight: 800;
            font-size: 1.35rem;
            letter-spacing: -0.6px;
            color: var(--sh-primary);
        }

        .sh-navbar .nav-link {
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--sh-slate);
            padding: 0.5rem 0.9rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sh-navbar .nav-link:hover {
            color: var(--sh-primary);
            background: var(--sh-primary-light);
        }

        /* Enterprise Cards & Animations */
        .sh-card {
            background: var(--sh-card-bg);
            border: 1px solid var(--sh-border);
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        }

        .sh-card-hover:hover {
            transform: translateY(-5px);
            border-color: #cbd5e1;
            box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
        }

        /* Avatar circle */
        .sh-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.88rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Buttons */
        .btn-sh-primary {
            background: var(--sh-primary);
            border-color: var(--sh-primary);
            color: #ffffff;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.55rem 1.25rem;
            transition: all 0.2s ease;
        }
        .btn-sh-primary:hover {
            background: var(--sh-primary-hover);
            border-color: var(--sh-primary-hover);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(30, 64, 175, 0.25);
        }

        .btn-sh-success {
            background-color: var(--sh-accent);
            border-color: var(--sh-accent);
            color: #ffffff !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.65rem 1.25rem;
            transition: all 0.2s ease;
        }
        .btn-sh-success:hover {
            background-color: var(--sh-accent-hover);
            border-color: var(--sh-accent-hover);
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }

        /* Badges */
        .badge-enterprise {
            padding: 0.45rem 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.78rem;
            letter-spacing: 0.2px;
        }

        /* Subtle Fade In Animation */
        .fade-in-up {
            animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Bootstrap Modal Stacking Fix */
        .modal {
            z-index: 1060 !important;
        }
        .modal-backdrop {
            z-index: 1050 !important;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--sh-border);
        }

        /* Hero Banner Styles */
        .sh-hero-banner {
            background: linear-gradient(135deg, #090d16 0%, #0f1f42 50%, #1e40af 100%);
            position: relative;
            overflow: hidden;
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .sh-hero-glow-1 {
            position: absolute;
            top: -100px;
            right: -50px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.35) 0%, rgba(99, 102, 241, 0.15) 45%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .sh-hero-glow-2 {
            position: absolute;
            bottom: -150px;
            left: -50px;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.22) 0%, transparent 65%);
            border-radius: 50%;
            pointer-events: none;
        }
        .sh-hero-grid-pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 28px 28px;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <!-- Enterprise Glassmorphism Header -->
    <nav class="navbar navbar-expand-lg sh-navbar py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Workshops" asp-action="Index">
                <div class="bg-primary text-white p-2 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                    <i class="bi bi-mortarboard-fill fs-5"></i>
                </div>
                <span>SkillHub</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <i class="bi bi-list fs-3 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Workshops" asp-action="Index">
                            <i class="bi bi-grid me-1 text-primary"></i> Catálogo
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Employee))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold" asp-controller="Workshops" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Publicar Taller
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Enrollments" asp-action="Import">
                                    <i class="bi bi-file-earmark-excel me-1 text-success"></i> Importar Excel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-muted" href="http://localhost:5180/scalar" target="_blank" title="Abrir documentación de la API en Scalar">
                                    <i class="bi bi-sliders me-1"></i> API Scalar <i class="bi bi-box-arrow-up-right small"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Enrollments" asp-action="Index">
                                    <i class="bi bi-bookmark-check me-1 text-primary"></i> Mis Inscripciones
                                </a>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Employee))
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-shield-lock-fill"></i> Instructor: @User.Identity.Name
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-person-check-fill"></i> @User.Identity.Name
                            </span>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm px-3 fw-semibold" style="border-radius: 8px;">
                                <i class="bi bi-box-arrow-right me-1"></i> Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm px-3 fw-semibold" style="border-radius: 8px;" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                        </a>
                        <a class="btn btn-sh-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Register">
                            Registrarse
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (IsSectionDefined("Hero"))
    {
        @RenderSection("Hero", required: false)
    }

    <!-- Main Container -->
    <main class="container my-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium">@TempData["Success"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium">@TempData["Error"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Clean Footer -->
    <footer class="py-4 text-muted small">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark">SkillHub</span>
                <span>•</span>
                <span>Centro de Formación Presencial</span>
            </div>
            <div>
                &copy; @DateTime.Now.Year SkillHub Platform. Clean Architecture .NET 10.
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Modals", required: false)

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
