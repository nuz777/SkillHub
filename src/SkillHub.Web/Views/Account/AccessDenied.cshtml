@{
    ViewData["Title"] = "Acceso Restringido";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card sh-card fade-in-up border-0 shadow-sm text-center p-4 p-md-5">
            <div class="p-4 rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Acceso Restringido</h3>
            <p class="text-secondary small mb-4">
                No dispones de los permisos de rol requeridos para visualizar esta sección. Si consideras que es un error, por favor contacta al administrador del sistema.
            </p>
            <div>
                <a asp-controller="Workshops" asp-action="Index" class="btn btn-sh-primary px-4 fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Regresar al Catálogo
                </a>
            </div>
        </div>
    </div>
</div>
