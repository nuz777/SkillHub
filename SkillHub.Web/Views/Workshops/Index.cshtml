@model IEnumerable<SkillHub.Application.DTOs.WorkshopDto>
@{
    ViewData["Title"] = "Talleres Presenciales";
    var isEmployee = User.IsInRole(UserRoles.Employee);
    var totalSpots = Model.Sum(w => w.AvailableSpots);
}

<!-- Hero Section -->
<div class="row align-items-center mb-4 pb-2">
    <div class="col-md-7">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white border rounded-pill shadow-xs mb-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">En Vivo</span>
            <span class="small text-muted fw-semibold">@totalSpots cupos disponibles en @Model.Count() talleres</span>
        </div>
        <h1 class="h2 fw-bold text-dark tracking-tight mb-1">Catálogo de Talleres Presenciales</h1>
        <p class="text-muted mb-0">Formación práctica intensiva en fotografía, cocina, oratoria, diseño y más.</p>
    </div>
    @if (isEmployee)
    {
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-sh-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Publicar Nuevo Taller
            </a>
            <a asp-controller="Enrollments" asp-action="Import" class="btn btn-outline-success fw-semibold ms-1" style="border-radius: 10px;">
                <i class="bi bi-file-earmark-excel me-1"></i> Importar Excel
            </a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card sh-card text-center py-5">
        <div class="card-body">
            <div class="bg-light text-muted p-4 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-calendar-x fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark">No hay talleres futuros disponibles</h5>
            <p class="text-muted small">Todos los talleres han iniciado o aún no se han programado nuevos cupos.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var workshop in Model)
        {
            var occupancyPercent = workshop.MaxCapacity > 0 
                ? (int)Math.Min(100, Math.Round((double)workshop.ActiveEnrollmentsCount / workshop.MaxCapacity * 100))
                : 100;
            var isFull = workshop.AvailableSpots <= 0;

            // Iniciales del instructor para el avatar
            var instructorInitials = string.Join("", (workshop.InstructorName ?? "SH")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(s => s[0]))
                .ToUpper();

            <div class="col-md-6 col-lg-4">
                <div class="card sh-card sh-card-hover h-100 p-3 p-xl-4 d-flex flex-column">
                    <!-- Card Top Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-secondary border fw-bold" style="border-radius: 6px; font-size: 0.78rem;">
                            @workshop.Code
                        </span>
                        @if (!isFull)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i> @workshop.AvailableSpots cupos libres
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle badge-enterprise d-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill"></i> Cupos agotados
                            </span>
                        }
                    </div>

                    <!-- Workshop Title & Description -->
                    <h5 class="fw-bold text-dark mb-2" style="line-height: 1.35;">@workshop.Title</h5>
                    <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                        @(workshop.Description.Length > 115 ? workshop.Description[..112] + "..." : workshop.Description)
                    </p>

                    <!-- Occupancy Progress Bar -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1" style="font-size: 0.75rem;">
                            <span>Ocupación (@workshop.ActiveEnrollmentsCount/@workshop.MaxCapacity)</span>
                            <span class="fw-bold">@occupancyPercent%</span>
                        </div>
                        <div class="progress" style="height: 6px; border-radius: 4px; background: #e2e8f0;">
                            <div class="progress-bar @(isFull ? "bg-danger" : occupancyPercent > 70 ? "bg-warning" : "bg-primary")" 
                                 role="progressbar" 
                                 style="width: @occupancyPercent%; border-radius: 4px;" 
                                 aria-valuenow="@occupancyPercent" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>

                    <!-- Instructor & Schedule Details -->
                    <div class="bg-light rounded-3 p-3 mb-3 small">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="sh-avatar" style="width: 30px; height: 30px; font-size: 0.75rem;">
                                @instructorInitials
                            </div>
                            <div class="text-truncate">
                                <span class="d-block fw-semibold text-dark lh-1">@workshop.InstructorName</span>
                                <span class="text-muted" style="font-size: 0.72rem;">@workshop.InstructorEmail</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 text-secondary pt-2 border-top" style="font-size: 0.78rem;">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span>@workshop.StartDate.ToString("dd MMM yyyy, HH:mm") UTC</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@workshop.Id" class="btn btn-outline-secondary btn-sm flex-fill fw-semibold" style="border-radius: 8px;">
                            Detalle
                        </a>

                        @if (isEmployee)
                        {
                            <a asp-action="Enrolled" asp-route-id="@workshop.Id" class="btn btn-outline-dark btn-sm flex-fill fw-semibold" style="border-radius: 8px;">
                                <i class="bi bi-people me-1"></i>Inscritos (@workshop.ActiveEnrollmentsCount)
                            </a>
                        }
                        else
                        {
                            @if (!isFull)
                            {
                                <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workshopId" value="@workshop.Id" />
                                    <button type="submit" class="btn btn-sh-primary btn-sm w-100 fw-semibold" style="border-radius: 8px;">
                                        <i class="bi bi-pencil-square me-1"></i>Inscribirme
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-light text-muted border btn-sm flex-fill fw-semibold" style="border-radius: 8px;" disabled>
                                    Agotado
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
