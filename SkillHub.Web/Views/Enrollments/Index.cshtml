@model IEnumerable<SkillHub.Application.DTOs.EnrollmentDto>
@{
    ViewData["Title"] = "Mis Inscripciones";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-card-checklist text-primary me-2"></i>Mis Inscripciones
        </h2>
        <p class="text-muted">Gestiona tus inscripciones a talleres, descarga constancias y revisa tu estado.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <a asp-controller="Workshops" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle me-1"></i> Explorar más talleres
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <i class="bi bi-journal-x text-muted display-4"></i>
            <h5 class="mt-3 text-muted">Aún no estás inscrito en ningún taller.</h5>
            <p class="text-secondary small">Explora el catálogo y reserva tu cupo en los talleres presenciales de SkillHub.</p>
            <a asp-controller="Workshops" asp-action="Index" class="btn btn-primary mt-2">
                Ver Talleres Disponibles
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Taller</th>
                        <th>Instructor</th>
                        <th>Fecha de Inscripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.WorkshopTitle</div>
                                <span class="badge bg-secondary-subtle text-secondary small">@item.WorkshopCode</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@item.InstructorName</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</span>
                            </td>
                            <td>
                                @if (item.Status == EnrollmentStatus.Active)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelada</span>
                                    @if (item.CancelledAt.HasValue)
                                    {
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @item.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    @if (item.Status == EnrollmentStatus.Active)
                                    {
                                        <a asp-action="Certificate" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Descargar constancia en PDF">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Constancia PDF
                                        </a>

                                        @if (item.CanCancel)
                                        {
                                            <form asp-action="Cancel" method="post" onsubmit="return confirm('¿Estás seguro de que deseas cancelar tu inscripción? Se liberará el cupo para otros participantes.');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i> Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="Solo se puede cancelar hasta 24 horas antes del inicio del taller">
                                                <i class="bi bi-lock me-1"></i> No cancelable (&lt;24h)
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sin acciones</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
