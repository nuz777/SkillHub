@{
    ViewData["Title"] = "Importación Masiva desde Excel";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-controller="Workshops" asp-action="Index" class="btn btn-link text-decoration-none px-0 mb-3 text-secondary fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a talleres
        </a>

        <div class="card sh-card fade-in-up border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="p-3 rounded-4 d-flex align-items-center justify-content-center text-success" style="width: 56px; height: 56px; background-color: rgba(16, 185, 129, 0.1);">
                        <i class="bi bi-file-earmark-excel fs-3"></i>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success fw-bold text-uppercase small px-2 py-1 mb-1">Carga Masiva</span>
                        <h3 class="fw-bold text-dark mb-0">Inscripción Masiva desde Excel</h3>
                        <p class="text-muted small mb-0">Importa listados de participantes y asígnalos automáticamente a sus talleres.</p>
                    </div>
                </div>

                <!-- Template Download Card -->
                <div class="p-3 rounded-3 bg-light border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-success fs-3"></i>
                        <div>
                            <div class="fw-bold text-dark small">Archivo Excel de Prueba Listo</div>
                            <div class="text-muted" style="font-size: 0.78rem;">Contiene filas con casos válidos y casos límite para testear.</div>
                        </div>
                    </div>
                    <a href="/sample_enrollments.xlsx" download="sample_enrollments.xlsx" class="btn btn-sm btn-outline-success fw-semibold px-3 text-nowrap">
                        <i class="bi bi-download me-1"></i> Descargar Plantilla .xlsx
                    </a>
                </div>

                <div class="alert alert-light border border-primary-subtle bg-primary-subtle bg-opacity-10 text-dark small rounded-3 mb-4 p-3">
                    <div class="d-flex gap-2">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <div>
                            <strong>Reglas de validación empresarial:</strong>
                            <p class="mb-0 text-secondary mt-1">
                                Cada fila es validada de forma individual verificando existencia, cupos disponibles, no duplicación y sin cruces de horario. Las filas válidas se guardan permanentemente en la base de datos aunque otras fallen.
                            </p>
                        </div>
                    </div>
                </div>

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Seleccionar Archivo Excel (.xlsx)</label>
                        <input type="file" name="file" class="form-control form-control-lg" accept=".xlsx" required />
                        <div class="form-text small mt-2">
                            El archivo debe contener las columnas: <code>ParticipantEmail</code> y <code>WorkshopCode</code>.
                        </div>
                    </div>

                    <div class="d-grid gap-2 pt-2">
                        <button type="submit" class="btn btn-sh-success py-3 fw-bold fs-6 shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-2 fs-5"></i> Procesar Inscripciones Masivas
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
